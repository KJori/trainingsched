# Optional. Everything here can also be set in the page, under Settings, and what you save there wins.
# Use this only if you'd rather configure from the server. To use it, add to each service in docker-compose.yml:
#     env_file: .env
# This file stays on your server; .env is in .gitignore.

# Name shown in the title and used by the coach, and the pronoun the coach uses (he or she).
ATHLETE_NAME=
ATHLETE_PRONOUN=he

# anthropic | openai | mistral | deepseek | gemini | openrouter | ollama | openai_compatible
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Optional. Defaults to the provider's public API. Required for openai_compatible.
LLM_BASE_URL=
# Optional cheaper model for small jobs (compacting the coach chat).
LLM_MODEL_QUICK=
# false for models without tool calling: the chat then gives advice but can't propose changes.
LLM_TOOLS=true

# Limits. These are only set here.
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=180000
