# Copy to .env and fill in. This file stays on your server; it is in .gitignore.

# Who each instance is for. The name shows in the page title and the coach uses it.
# Pronoun: he or she (the coach's instructions are written with it).
ATHLETE_1_NAME=
ATHLETE_1_PRONOUN=he
ATHLETE_2_NAME=
ATHLETE_2_PRONOUN=she

# ---- Coach ----
# Leave LLM_PROVIDER empty to run without the coach:
# logging, plan, progression, checks and charts all work without it.

# anthropic | openai | mistral | deepseek | gemini | openrouter | ollama | openai_compatible
LLM_PROVIDER=

# Model name as your provider writes it. Examples (check your provider for current names):
#   anthropic: claude-sonnet-5-5      openai: gpt-5-mini        mistral: mistral-medium-latest
#   deepseek:  deepseek-chat          gemini: gemini-2.5-flash  ollama:  qwen3:14b
LLM_MODEL=

# Not needed for ollama.
LLM_API_KEY=

# Optional. Defaults to the provider's public API. Required for openai_compatible.
# For Ollama on another machine: http://192.168.1.50:11434/v1
LLM_BASE_URL=

# Optional cheaper model for small jobs (compacting the coach chat).
LLM_MODEL_QUICK=

# Plan and number proposals in the coach chat need tool calling.
# Set to false for local models that don't support tools; the chat then gives advice only.
LLM_TOOLS=true

# Optional limits.
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_MS=180000
